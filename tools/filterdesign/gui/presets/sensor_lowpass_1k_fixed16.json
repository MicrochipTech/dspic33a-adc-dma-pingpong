{
  "format": "fdesign-gui",
  "version": 1,
  "spec": {
    "type": "lowpass",
    "characteristic": "chebyshev",
    "fs": 1000,
    "ap": 3,
    "as": 40,
    "edges": {
      "lowpass": [
        10.0,
        30.0
      ]
    }
  },
  "implementation": {
    "arithmetic": "fixed16",
    "section_scaling": true,
    "auto_q": true,
    "frac_bits": 14,
    "c_name": "sensor_lp"
  },
  "view": {
    "dark": true,
    "magnitude_scale": "db",
    "frequency_axis": "log",
    "tolerance_scheme": true,
    "implemented_response": true,
    "phase": "unwrap",
    "group_delay_unit": "ms",
    "time_response": "step",
    "test_view": "freq"
  },
  "test": {
    "implementations": [
      "float",
      "double",
      "fixed32",
      "fixed16"
    ],
    "signal": "step",
    "f1": 5.0,
    "f2": 45.0,
    "amplitude": 0.5,
    "samples": 4096,
    "compiler": "gcc"
  }
}
